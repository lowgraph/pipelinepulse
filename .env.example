# Optional server-side LLM adapter. Raw CSVs are recomputed by this app's server;
# only anonymous aggregate facts are forwarded to this endpoint.
# POST { "instructions": "...", "facts": { ... } } -> { "text": "..." }
LLM_EXPLANATION_URL=
LLM_EXPLANATION_TOKEN=
# Set the exact external origin when deploying behind a TLS reverse proxy.
APP_ORIGIN=
